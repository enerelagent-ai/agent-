# Optional -- unset (the default) leaves every route open, for local dev.
# Set both in production (Vercel) to require login (see app/login) for the
# whole site. Must match the backend's ADMIN_USERNAME/ADMIN_PASSWORD (see
# backend/.env.example) for two reasons: the src/app/api/backend proxy's
# server-to-server call authenticates with them, and ADMIN_PASSWORD also
# doubles as the signing key for the login session cookie (see
# src/lib/session.ts) -- no separate session secret to configure. See
# src/middleware.ts.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Optional -- defaults to http://localhost:8000 (the local backend). Set in
# production (Vercel) to the deployed backend's URL (Render), with no
# trailing slash. Server-side only (no NEXT_PUBLIC_ prefix): read by
# src/app/api/backend/[...path]/route.ts, never shipped to the browser.
# BACKEND_API_URL=

# Release switches. Both default to false when omitted. Marketplace V2 can
# become the root experience independently from verified-complex insights.
# MARKETPLACE_V2_ENABLED=false
# COMPLEX_INSIGHTS_ENABLED=false
