# Optional -- unset (the default) leaves every route open, for local dev.
# Set both in production (Vercel) to require Basic Auth on the whole site.
# Must match the backend's ADMIN_USERNAME/ADMIN_PASSWORD (see
# backend/.env.example) so the src/app/api/backend proxy's server-to-server
# call authenticates too. See src/middleware.ts.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Optional -- defaults to http://localhost:8000 (the local backend). Set in
# production (Vercel) to the deployed backend's URL (Render), with no
# trailing slash. Server-side only (no NEXT_PUBLIC_ prefix): read by
# src/app/api/backend/[...path]/route.ts, never shipped to the browser.
# BACKEND_API_URL=
